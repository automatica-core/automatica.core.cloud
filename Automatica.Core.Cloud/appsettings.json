{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "No secrets in this file. Secrets come from Key Vault (KeyVault:Uri, '--' separates sections, e.g. Jwt--SigningKey) or from dotnet user-secrets locally.",

  "KeyVault": {
    "Uri": ""
  },
  "ConnectionStrings": {
    "AutomaticaCoreCloudSql": "",
    "AutomaticaCoreUpdateStore": "",
    "AutomaticaTextToSpeechStorage": "",
    "AutomaticaAzureEmailCommunication": ""
  },
  "Jwt": {
    "Issuer": "automatica-cloud",
    "Audience": "automatica-cloud-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Mail": {
    "SenderAddress": "cloud@automaticacore.com"
  },
  "TextToSpeech": {
    "Region": "westeurope"
  },
  "RemoteControl": {
    "ResourceGroup": "automatica",
    "DnsZoneName": "automaticaremote.com",
    "CNameTarget": "dev.automaticaremote.com",
    "CNamePrefix": "dev"
  },
  "Frps": {
    "RequireApiKeyMeta": false
  },
  "Seed": {
    "AdminUserName": "admin",
    "PublisherName": "automatica.core"
  }
}

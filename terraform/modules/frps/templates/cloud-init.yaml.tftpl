#cloud-config
# Rendered by terraform. Contains no secrets: frps reads them from Key Vault at every start
# (/usr/local/sbin/frps-render-config). Rotate a secret in Key Vault, then: systemctl restart frps

package_update: true
package_upgrade: true
packages:
  - nginx
  - jq
  - curl
  - unattended-upgrades

users:
  - name: frps
    system: true
    shell: /usr/sbin/nologin

write_files:
  - path: /usr/local/sbin/frps-render-config
    permissions: "0750"
    owner: root:root
    content: |
      ${indent(6, render_script)}
  - path: /etc/systemd/system/frps.service
    permissions: "0644"
    owner: root:root
    content: |
      ${indent(6, frps_service)}
  - path: /etc/nginx/sites-available/frps
    permissions: "0644"
    owner: root:root
    content: |
      ${indent(6, nginx_conf)}
  - path: /etc/systemd/system/nginx-reload.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Reload nginx to pick up a renewed certificate
      [Service]
      Type=oneshot
      ExecStart=/usr/bin/systemctl reload nginx
  - path: /etc/systemd/system/nginx-reload.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Daily nginx reload (certificate renewal)
      [Timer]
      OnCalendar=daily
      Persistent=true
      [Install]
      WantedBy=timers.target

runcmd:
  - [bash, -c, "set -euo pipefail; cd /tmp; curl -fsSLo frp.tgz https://github.com/fatedier/frp/releases/download/v${frp_version}/frp_${frp_version}_linux_amd64.tar.gz; echo '${frp_sha256}  frp.tgz' | sha256sum -c -; tar xzf frp.tgz; install -m 0755 frp_${frp_version}_linux_amd64/frps /usr/local/bin/frps; rm -rf frp.tgz frp_${frp_version}_linux_amd64"]
  - [mkdir, -p, /etc/frp, /etc/nginx/certs]
  - [rm, -f, /etc/nginx/sites-enabled/default]
  - [ln, -sf, /etc/nginx/sites-available/frps, /etc/nginx/sites-enabled/frps]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, frps.service]
  - [systemctl, enable, --now, nginx-reload.timer]
  # the certificate arrives through the KeyVaultForLinux extension; nginx starts once it is there
  - [bash, -c, "for i in $(seq 1 60); do ls /etc/nginx/certs/* >/dev/null 2>&1 && break; sleep 10; done; systemctl restart nginx"]

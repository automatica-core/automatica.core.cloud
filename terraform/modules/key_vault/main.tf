# Per-environment Key Vault (RBAC). Holds every app secret; the app reads it through its managed identity
# (KeyVault:Uri, secret names use "--" for ":"), the frps VM through its user-assigned identity.
#
# Generated here: Jwt--SigningKey, Frps--Token, Frps--PluginSecret, Frps--DashboardPassword.
# Set by hand (never in tfvars, see terraform/README.md): License--PrivateKeyPassword, optionally Seed--AdminPassword.

variable "name" { type = string }
variable "resource_group_name" { type = string }
variable "location" { type = string }
variable "tenant_id" { type = string }
variable "tags" { type = map(string) }
variable "deployer_object_id" {
  type        = string
  description = "Object id of the identity running terraform; gets Key Vault Secrets Officer to write the generated secrets."
}
variable "extra_secrets" {
  type        = map(string)
  default     = {}
  sensitive   = true
  description = "Secrets that come from other resources (e.g. the speech key). Never pass values from tfvars."
}

resource "azurerm_key_vault" "this" {
  name                          = var.name
  resource_group_name           = var.resource_group_name
  location                      = var.location
  tenant_id                     = var.tenant_id
  sku_name                      = "standard"
  rbac_authorization_enabled    = true
  purge_protection_enabled      = true
  soft_delete_retention_days    = 90
  public_network_access_enabled = true
  tags                          = var.tags
}

resource "azurerm_role_assignment" "deployer" {
  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = var.deployer_object_id
}

resource "random_bytes" "jwt_signing_key" {
  length = 64
}

resource "random_password" "frps" {
  for_each = toset(["token", "plugin", "dashboard"])
  length   = 48
  special  = false
}

locals {
  generated = {
    "Jwt--SigningKey"         = random_bytes.jwt_signing_key.base64
    "Frps--Token"             = random_password.frps["token"].result
    "Frps--PluginSecret"      = random_password.frps["plugin"].result
    "Frps--DashboardPassword" = random_password.frps["dashboard"].result
  }
}

resource "azurerm_key_vault_secret" "generated" {
  for_each     = nonsensitive(toset(keys(local.generated)))
  name         = each.key
  value        = local.generated[each.key]
  key_vault_id = azurerm_key_vault.this.id
  content_type = "generated by terraform"
  depends_on   = [azurerm_role_assignment.deployer]
}

resource "azurerm_key_vault_secret" "extra" {
  for_each     = nonsensitive(toset(keys(var.extra_secrets)))
  name         = each.key
  value        = var.extra_secrets[each.key]
  key_vault_id = azurerm_key_vault.this.id
  content_type = "managed by terraform"
  depends_on   = [azurerm_role_assignment.deployer]
}

output "id" { value = azurerm_key_vault.this.id }
output "uri" { value = azurerm_key_vault.this.vault_uri }
output "name" { value = azurerm_key_vault.this.name }
output "secret_versionless_ids" {
  value = { for k, s in azurerm_key_vault_secret.generated : k => s.versionless_id }
}
